# Firebase Admin credentials: choose ONE method.
# Method A: paste the complete service-account JSON as one Railway variable.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Method B: base64-encoded service-account JSON.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Method C: individual fields.
FIREBASE_PROJECT_ID=neon-riddle-2060-admin
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Initial administrator UID(s), comma-separated.
ADMIN_UIDS=EE2dpbeCwnSe1Ih7yahI5AhTSK13

# Browser origins allowed to call this API. Do not include paths.
ALLOWED_ORIGINS=https://track2000one.github.io,http://localhost:5500,http://127.0.0.1:5500

# Optional: write audit records to Firestore collection adminAuditLogs.
ENABLE_FIRESTORE_AUDIT=false

# Preferred transactional delivery for Railway Free/Trial/Hobby plans.
# Create a Brevo API key and store it only as a Railway secret variable.
BREVO_API_KEY=

# Optional SMTP fallback for Railway Pro plans and above.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# This must be a verified sender address in Brevo.
EMAIL_FROM=
EMAIL_FROM_NAME=NEON Academy 2060
EMAIL_REPLY_TO=

# Authorized Firebase continue URL after the password has been reset.
PASSWORD_RESET_RETURN_URL=https://track2000one.github.io/neon-riddle-2060/academy/auth.html#login
